# .claude bleibt lokal (settings*.json), nur die Subagenten-Definitionen werden versioniert
.claude/*
!.claude/agents/
docs/node_modules/
docs/package.json
docs/package-lock.json
docs/screenshot.js
docs/enter-zoom-*.png

# Temp-/Build-Artefakte
*.af~lock~
*~
__pycache__/
*.pyc
Info/

# --- Arbeits-.af unter templates/hersteller/ nicht mehr ins Git (Variante B, 2026-09) ---
# Grund: GitHubs 100-MB-Limit, Snapshots blaehen Affinity-Dateien stark auf.
# Bereits getrackte .af bleiben getrackt (diese Regel untrackt nichts automatisch).
# Meilenstein-/Hersteller-Versionen gehoeren nach templates/release/ (Git LFS, siehe .gitattributes).
templates/hersteller/**/*.af

