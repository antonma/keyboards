  "compat_file": "designs/_shared/75-iso-de-compat-akko.yaml",
  "design_notes": {
    "body_groups": "4 Body-Farbgruppen + F-Row-Gradient (5 Farbtoene)",
    "legend_variants": "A = einheitlich warm brown, B = weiss auf pink/rose, braun auf cream/white/rose-gold. Affinity-Test entscheidet.",
    "sakura_petals": "7 Alphas mit einzelnem gemalten Petal-Overlay (Q, P, D, L, Ae, C, V, N laut Ideogram-Master)",
    "artwork_keys": "Spacebar (voll) + ISO-Enter (klein) tragen Sakura-Branch-Artwork — Anton fuegt selbst in Affinity ein",
    "f_row_gradient": "F1-F12 in 4 Rose-Gold-Abstufungen; Hersteller-Risiko: falls kein Gradient moeglich, Fallback auf rose_gold_mid",
    "compat_keys": "5 Keys im Alternates-Block (DRUCK, ROLLEN, PAUSE, EINFG, MENU) in body_nav (gleich wie Nav-Cluster)"
  },
